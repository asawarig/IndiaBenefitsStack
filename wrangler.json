{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-benefits-stack",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ]
}
