<script is:inline>
  // Webflow's own navbar script (web-interactives-embed.js) is not bundled
  // here, so the hamburger and the dropdowns need driving manually. This
  // reproduces the class contract Webflow's CSS already expects:
  //   button      .w--open
  //   menu        [data-nav-menu-open]
  //   dropdown    .w--open on toggle + list
  (function () {
    var navRoot = document.querySelector('.navbar.w-nav');
    if (!navRoot) return;

    // Plum's navbar does NOT use Webflow's .w-nav-button / .w-nav-menu. It has
    // a custom .nav-hamburger (three lines) and hides .nav-menu with
    // display:none below the breakpoint. So the open/close state is ours to
    // define: .nav--menu-open on the navbar, styled in guide.css.
    var button = navRoot.querySelector('.nav-hamburger');
    var menu   = navRoot.querySelector('.nav-menu');

    function setOpen(open) {
      if (!button || !menu) return;
      navRoot.classList.toggle('nav--menu-open', open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    if (button && menu) {
      button.setAttribute('role', 'button');
      button.setAttribute('tabindex', '0');
      button.setAttribute('aria-label', 'Menu');
      button.setAttribute('aria-expanded', 'false');
      button.addEventListener('click', function (e) {
        e.preventDefault();
        setOpen(!navRoot.classList.contains('nav--menu-open'));
      });
      button.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); button.click(); }
      });
      // Following a link should close the panel.
      menu.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
    }
    addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    addEventListener('resize', function () {
      if (innerWidth > 991) setOpen(false);
    }, { passive: true });

    // Mobile accordion. Above 991px the dropdowns open on hover, from the
    // inline <style> in the head. Below it there is no hover and IX2 is what
    // Webflow uses to expand them, so the tap handler is ours: toggle
    // .nav-item--open (styled in chrome.css) and close the siblings.
    var navItems = Array.prototype.slice.call(navRoot.querySelectorAll(".nav-item"));
    navItems.forEach(function (item) {
      var link = item.querySelector(".nav-item-link");
      var panel = item.querySelector(".nav-item-dropdown");
      if (!link || !panel) return;
      link.setAttribute("role", "button");
      link.setAttribute("tabindex", "0");
      link.setAttribute("aria-expanded", "false");
      function toggle(e) {
        if (innerWidth > 991) return;   // hover territory, leave it to CSS
        e.preventDefault();
        var open = !item.classList.contains("nav-item--open");
        navItems.forEach(function (o) {
          o.classList.remove("nav-item--open");
          var l = o.querySelector(".nav-item-link");
          if (l) l.setAttribute("aria-expanded", "false");
        });
        if (open) {
          item.classList.add("nav-item--open");
          link.setAttribute("aria-expanded", "true");
        }
      }
      link.addEventListener("click", toggle);
      link.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") toggle(e);
      });
    });
    // Leaving mobile clears the accordion so it cannot fight the hover rule.
    addEventListener("resize", function () {
      if (innerWidth > 991) navItems.forEach(function (o) {
        o.classList.remove("nav-item--open");
        var l = o.querySelector(".nav-item-link");
        if (l) l.setAttribute("aria-expanded", "false");
      });
    }, { passive: true });

    // Dropdowns: click to toggle, and close the others.
    var dropdowns = Array.prototype.slice.call(navRoot.querySelectorAll('.w-dropdown'));
    dropdowns.forEach(function (dd) {
      var toggle = dd.querySelector('.w-dropdown-toggle');
      var list   = dd.querySelector('.w-dropdown-list');
      if (!toggle || !list) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        var open = !list.classList.contains('w--open');
        dropdowns.forEach(function (o) {
          var l = o.querySelector('.w-dropdown-list'), t = o.querySelector('.w-dropdown-toggle');
          if (l) l.classList.remove('w--open');
          if (t) { t.classList.remove('w--open'); t.setAttribute('aria-expanded', 'false'); }
        });
        if (open) {
          list.classList.add('w--open');
          toggle.classList.add('w--open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
    document.addEventListener('click', function (e) {
      if (!navRoot.contains(e.target)) {
        dropdowns.forEach(function (o) {
          var l = o.querySelector('.w-dropdown-list'), t = o.querySelector('.w-dropdown-toggle');
          if (l) l.classList.remove('w--open');
          if (t) { t.classList.remove('w--open'); t.setAttribute('aria-expanded', 'false'); }
        });
      }
    });

    // Webflow's IX2 scroll interaction is not bundled, so drive the bar's
    // scrolled state here: transparent over the red masthead, solid once the
    // cream article is behind it.
    var masthead = document.querySelector('.masthead');
    function onScrollState() {
      var past = masthead
        ? masthead.getBoundingClientRect().bottom <= (navRoot.querySelector('.nav') || navRoot).offsetHeight
        : window.scrollY > 24;
      navRoot.classList.toggle('nav--scrolled', past);
    }
    onScrollState();
    addEventListener('scroll', onScrollState, { passive: true });
    addEventListener('resize', onScrollState, { passive: true });

    // Publish the navbar's real height so the sticky TOC rail can clear it.
    function measure() {
      var bar = navRoot.querySelector('.nav-container-3') || navRoot;
      var h = Math.round(bar.getBoundingClientRect().height);
      if (h > 0) document.documentElement.style.setProperty('--chrome-nav-h', h + 'px');
    }
    measure();
    addEventListener('resize', measure, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  })();
</script>
<script is:inline>
  // Mark the entry currently being read in the TOC rail, and mark its parent
  // entries too, so a reader deep in a sub-section can still see which
  // top-level section they are in.
  //
  // Uses a scroll-position probe rather than plain IntersectionObserver
  // visibility, so the "current" entry stays stable through tall sections and
  // never flickers between two entries at a boundary.
  (function () {
    var links = Array.prototype.slice.call(
      document.querySelectorAll('.toc-bar a[href^="#"]')
    );
    if (!links.length) return;

    // Document order of the targets is the order they appear on the page,
    // which is what the probe walks. Nesting does not change that.
    var targets = links
      .map(function (a) {
        return { link: a, el: document.getElementById(a.getAttribute('href').slice(1)) };
      })
      .filter(function (t) { return t.el; });

    // For each link, the chain of ancestor links (parent <li> -> its <a>).
    function ancestorsOf(a) {
      var out = [], li = a.parentElement;
      while (li) {
        var ul = li.parentElement;
        if (!ul || !ul.closest) break;
        var parentLi = ul.parentElement;
        if (!parentLi || parentLi.tagName !== 'LI') break;
        var pa = parentLi.querySelector(':scope > a');
        if (pa) out.push(pa);
        li = parentLi;
      }
      return out;
    }

    var current = null, marked = [];
    function update() {
      // Fixed, small offset rather than a share of the viewport: sibling
      // headings can sit ~220px apart, and a 25%-of-viewport probe (225px at
      // 900px tall) would skip past the nearer one to the next.
      var probe = 96;
      var found = targets[0];
      for (var i = 0; i < targets.length; i++) {
        // viewport-relative: correct regardless of offsetParent nesting
        if (targets[i].el.getBoundingClientRect().top <= probe) found = targets[i];
      }
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 2) {
        found = targets[targets.length - 1];
      }
      if (found === current) return;

      if (current) current.link.removeAttribute('aria-current');
      marked.forEach(function (a) { a.removeAttribute('data-ancestor'); });

      found.link.setAttribute('aria-current', 'true');
      marked = ancestorsOf(found.link);
      marked.forEach(function (a) { a.setAttribute('data-ancestor', ''); });
      current = found;
    }

    var queued = false;
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; update(); });
    }

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  })();
</script>
</body>
</html>
