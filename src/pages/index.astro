          <td class="col-global">80% of companies</td>
        </tr>
        <tr>
          <td><strong>Employer-sponsored primary healthcare</strong></td>
          <td class="col-india">18% of companies</td>
          <td class="col-global">80% of companies</td>
        </tr>
        <tr>
