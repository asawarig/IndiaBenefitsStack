<script is:inline>
  // Mark the section currently being read in the TOC rail. Uses a scroll
  // position probe rather than plain IntersectionObserver visibility, so the
  // "current" item stays stable through tall sections and never flickers
  // between two entries at a boundary.
  (function () {
    var links = Array.prototype.slice.call(
      document.querySelectorAll('.toc-bar a[href^="#"]')
    );
    if (!links.length) return;

    var targets = links
      .map(function (a) {
        return { link: a, el: document.getElementById(a.getAttribute('href').slice(1)) };
      })
      .filter(function (t) { return t.el; });

    var current = null;
    function update() {
      var probe = window.innerHeight * 0.25;
      var found = targets[0];
      for (var i = 0; i < targets.length; i++) {
        // viewport-relative: correct regardless of offsetParent nesting
        if (targets[i].el.getBoundingClientRect().top <= probe) found = targets[i];
      }
      // at the very bottom the last section wins even if it is short
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 2) {
        found = targets[targets.length - 1];
      }
      if (found === current) return;
      if (current) current.link.removeAttribute('aria-current');
      found.link.setAttribute('aria-current', 'true');
      current = found;
    }

    var queued = false;
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; update(); });
    }

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  })();
</script>
