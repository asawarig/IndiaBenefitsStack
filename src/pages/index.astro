<script is:inline>
  // Mark the entry currently being read in the TOC rail, and mark its parent
  // entries too, so a reader deep in a sub-section can still see which
  // top-level section they are in.
  //
  // Uses a scroll-position probe rather than plain IntersectionObserver
  // visibility, so the "current" entry stays stable through tall sections and
  // never flickers between two entries at a boundary.
  (function () {
    var links = Array.prototype.slice.call(
      document.querySelectorAll('.toc-bar a[href^="#"]')
    );
    if (!links.length) return;

    // Document order of the targets is the order they appear on the page,
    // which is what the probe walks. Nesting does not change that.
    var targets = links
      .map(function (a) {
        return { link: a, el: document.getElementById(a.getAttribute('href').slice(1)) };
      })
      .filter(function (t) { return t.el; });

    // For each link, the chain of ancestor links (parent <li> -> its <a>).
    function ancestorsOf(a) {
      var out = [], li = a.parentElement;
      while (li) {
        var ul = li.parentElement;
        if (!ul || !ul.closest) break;
        var parentLi = ul.parentElement;
        if (!parentLi || parentLi.tagName !== 'LI') break;
        var pa = parentLi.querySelector(':scope > a');
        if (pa) out.push(pa);
        li = parentLi;
      }
      return out;
    }

    var current = null, marked = [];
    function update() {
      // Fixed, small offset rather than a share of the viewport: sibling
      // headings can sit ~220px apart, and a 25%-of-viewport probe (225px at
      // 900px tall) would skip past the nearer one to the next.
      var probe = 96;
      var found = targets[0];
      for (var i = 0; i < targets.length; i++) {
        // viewport-relative: correct regardless of offsetParent nesting
        if (targets[i].el.getBoundingClientRect().top <= probe) found = targets[i];
      }
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 2) {
        found = targets[targets.length - 1];
      }
      if (found === current) return;

      if (current) current.link.removeAttribute('aria-current');
      marked.forEach(function (a) { a.removeAttribute('data-ancestor'); });

      found.link.setAttribute('aria-current', 'true');
      marked = ancestorsOf(found.link);
      marked.forEach(function (a) { a.setAttribute('data-ancestor', ''); });
      current = found;
    }

    var queued = false;
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; update(); });
    }

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  })();
</script>
